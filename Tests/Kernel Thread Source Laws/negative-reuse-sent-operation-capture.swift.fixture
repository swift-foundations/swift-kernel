// Expected rejection: the non-Sendable capture region was transferred into run.
import Kernel

struct Input: ~Copyable, ~Escapable, Sendable {}

final class Capture {
    var value = 42
}

func run(_ input: borrowing Input) throws(Kernel.Thread.Run.Error<Never>) -> Int {
    let capture = Capture()
    let output = try Kernel.Thread.run(input) { _ in capture.value }
    capture.value = 0
    return output
}
