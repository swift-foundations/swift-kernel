import Kernel

struct Input: ~Copyable, ~Escapable, Sendable {}

final class Capture {
    let value: Int

    init(value: Int) {
        self.value = value
    }
}

func run(_ input: borrowing Input) throws(Kernel.Thread.Run.Error<Never>) -> Int {
    let capture = Capture(value: 42)
    return try Kernel.Thread.run(input) { _ in capture.value }
}
