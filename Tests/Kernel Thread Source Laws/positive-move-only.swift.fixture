import Kernel

struct Input: ~Copyable, ~Escapable, Sendable {
    let value: Int
}

struct Output: ~Copyable {
    let value: Int
}

func run(_ input: borrowing Input) throws(Kernel.Thread.Run.Error<Never>) -> sending Output {
    try Kernel.Thread.run(input) { input in
        Output(value: input.value)
    }
}
